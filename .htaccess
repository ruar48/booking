# Hostinger's Git deployment publishes the whole repository into public_html,
# so the web root is the project root instead of public/. Route every request
# into public/, where Laravel's index.php and the built assets live.
#
# This also keeps .env, vendor/, storage/ and the rest of the project out of
# reach: a request for /.env is looked up as public/.env, which doesn't exist.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # One address for the site: www.galaangramospickleball.com served a full
    # duplicate, which search engines can count as a second, competing site.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Belt and braces in case mod_rewrite is ever off: never list directories.
Options -Indexes
